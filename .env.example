# Secret key untuk enkripsi token JWT NextAuth.js
NEXTAUTH_SECRET="rahasia-super-aman-my-ojol-finance-2026"

# URL dasar aplikasi saat berjalan di lokal atau produksi
NEXTAUTH_URL="http://localhost:3000"
