// Skema Database Prisma untuk aplikasi my-ojol-finance
// Menggunakan provider PostgreSQL (Vercel Postgres)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL") 
}

// Model User untuk menyimpan kredensial akun pengemudi ojek online
model User {
  id           String        @id @default(cuid())
  username     String        @unique
  password     String        // Hashed password
  transactions Transaction[]
  bills        Bill[]
}

// Model Transaction untuk menyimpan riwayat pemasukan (INCOME) dan pengeluaran (EXPENSE) harian
model Transaction {
  id        String   @id @default(cuid())
  userId    String
  type      String   // "INCOME" atau "EXPENSE"
  amount    Int      
  category  String   
  date      DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

// Model Bill untuk menyimpan daftar pengingat tagihan/cicilan beserta status pembayarannya
model Bill {
  id        String   @id @default(cuid())
  userId    String
  title     String   
  amount    Int
  dueDate   DateTime
  isPaid    Boolean  @default(false)
  user      User     @relation(fields: [userId], references: [id])
}
